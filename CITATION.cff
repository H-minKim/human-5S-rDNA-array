    given-names: "Hyungmin"
license: MIT
repository-code: "https://github.com/H-minKim/human-5S-rDNA-array"
url: "https://github.com/H-minKim/human-5S-rDNA-array"
version: 1.0.0
date-released: 2026-11-09
keywords:
  - 5S rDNA
  - tandem array
  - long-read sequencing
  - DNA methylation
  - Fiber-seq
  - chromatin accessibility
  - RNA polymerase III
preferred-citation:
  type: article
  title: >-
    Long-read analysis of complete human 5S rDNA arrays reveals a zoned
    organization with two-state unit methylation linked to chromatin
    architecture
